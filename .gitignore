# Dependencias y cachés de herramientas
node_modules/
.npm-cache/

# Directorios de herramientas locales
.atl/
.codegraph/
.playwright-cli/
# Estado de la misión del arnés de OpenCode: es de la máquina, no del repositorio.
# El adaptador del tablero vive en .tasks-ai/extensions/opencode.
.opencode/

# Estado del arnés: se versiona para llevarlo a otra máquina
#   .pi/  el paquete de Pi instalado en el proyecto y el agente de delegación
# El modelo elegido para el subagente con /gentle:models no viaja: es de esta máquina.
.pi/subagents.json

# Memoria local de Engram: sus datos son de esta máquina. Solo viaja el ajuste que
# ata el proyecto a su nombre; la memoria se reconstruye trabajando, no se copia.
.engram/*
!.engram/config.json

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace

# Registros
*.log
npm-debug.log*

# Marcadores de zona de seguridad de Windows (ADS)
*:Zone.Identifier

# Entorno: nunca se versiona, las claves no viajan en el repositorio
.env
.env.local
.env.*.local

# Base del tablero: vive en esta máquina y no viaja. Un binario de SQLite no se
# fusiona, así que cada máquina tiene el suyo y el repositorio guarda solo las
# instrucciones. Sus transitorios tampoco viajan: copiarlos corrompe lecturas.
.tasks-ai/tasks.db
.tasks-ai/tasks.db-wal
.tasks-ai/tasks.db-shm

# Las piezas que el producto instala en un proyecto: el binario y la extensión
# salen de este mismo repositorio, así que `make install` las regenera y no
# viajan. El binario ya queda cubierto por `bin/`.
.tasks-ai/extensions/

# Salidas generadas
bin/
coverage/
dist/
#   .run/  los pid y los registros de los servidores que levantan serve.sh y serve-web.sh
.run/
