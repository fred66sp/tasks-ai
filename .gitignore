# Dependencias y cachés de herramientas
node_modules/
.npm-cache/

# Directorios de herramientas locales
.atl/
.codegraph/
.playwright-cli/

# Estado del arnés: se versiona para llevarlo a otra máquina
#   .pi/  el paquete de Pi instalado en el proyecto y el agente de delegación
.engram/*
!.engram/config.json

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace

# Registros
*.log
npm-debug.log*

# Marcadores de zona de seguridad de Windows (ADS)
*:Zone.Identifier

# Entorno: nunca se versiona, las claves no viajan en el repositorio
.env
.env.local
.env.*.local

# Base del tablero: se versiona para llevarla a otra máquina, con el contenido del
# WAL ya integrado. Sus archivos transitorios no viajan: copiarlos corrompe lecturas.
#   .task-ai/tasks.db  las tareas del proyecto
.task-ai/tasks.db-wal
.task-ai/tasks.db-shm

# Salidas generadas
bin/
coverage/
dist/
